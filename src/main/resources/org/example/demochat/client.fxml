<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demochat.controller.ClientController">
   <children>
      <Text fx:id="lblClientTitle" layoutX="129.0" layoutY="41.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Client">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Text>
      <TextArea fx:id="messageArea" layoutX="17.0" layoutY="55.0" prefHeight="236.0" prefWidth="317.0" />
      <TextField fx:id="txtMessage" layoutX="17.0" layoutY="308.0" prefHeight="40.0" prefWidth="202.0" promptText="Enter message here" />
      <Button fx:id="btnAdd" layoutX="230.0" layoutY="307.0" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="34.0" prefWidth="46.0" style="-fx-background-color: black;" text="+" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="22.0" />
         </font>
      </Button>
      <Button fx:id="btnSend" layoutX="281.0" layoutY="307.0" mnemonicParsing="false" onAction="#btnSendOnAction" prefHeight="40.0" prefWidth="54.0" style="-fx-background-color: blue;" text="send" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
