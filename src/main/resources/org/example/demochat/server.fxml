<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="393.0" prefWidth="563.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demochat.controller.ServerController">
   <children>
      <Text fx:id="lblServerTitle" layoutX="231.0" layoutY="38.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Server">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Text>
      <TextArea fx:id="messageArea" layoutX="17.0" layoutY="55.0" prefHeight="227.0" prefWidth="318.0" />
      <TextField fx:id="txtMessage" layoutX="17.0" layoutY="316.0" prefHeight="40.0" prefWidth="251.0" promptText="Enter message here" />
      <Button fx:id="btnDownload" layoutX="400.0" layoutY="276.0" mnemonicParsing="false" onAction="#btnDownloadOnAction" prefHeight="23.0" prefWidth="95.0" style="-fx-background-color: black;" text="download" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnSend" layoutX="278.0" layoutY="317.0" mnemonicParsing="false" onAction="#btnSendOnAction" prefHeight="36.0" prefWidth="54.0" style="-fx-background-color: blue;" text="send" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="14.0" />
         </font>
      </Button>
      <ImageView fx:id="imageView" fitHeight="198.0" fitWidth="200.0" layoutX="348.0" layoutY="55.0" pickOnBounds="true" preserveRatio="true" />
   </children>
</AnchorPane>
